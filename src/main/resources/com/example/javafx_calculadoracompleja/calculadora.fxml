<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<!-- Rejilla de botones ordenada -->

<GridPane fx:id="gpPrincipal" hgap="10.0" stylesheets="style.css" vgap="10.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafx_calculadoracompleja.CalculadoraControlador">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
        <children>
            <!-- Fila 0: Limpiar y Operadores principales -->
            <Button fx:id="btnLimpiar" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="50.0" prefWidth="60.0" styleClass="btn-danger" text="C" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCambioSigno" prefHeight="50.0" prefWidth="60.0" styleClass="btn-op" text="±" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
            <Button fx:id="porcentaje" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handlePorcentaje" prefHeight="50.0" prefWidth="60.0" styleClass="btn-op" text="\%" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleOperador" prefHeight="50.0" prefWidth="60.0" styleClass="btn-op" text="÷" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS" />

            <!-- Fila 1: 7, 8, 9, Multiplicación -->
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="60.0" text="7" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="60.0" text="8" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="60.0" text="9" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleOperador" prefHeight="50.0" prefWidth="60.0" styleClass="btn-op" text="×" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS" />

            <!-- Fila 2: 4, 5, 6, Resta -->
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="60.0" text="4" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="60.0" text="5" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="60.0" text="6" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleOperador" prefHeight="50.0" prefWidth="60.0" styleClass="btn-op" text="-" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" GridPane.vgrow="ALWAYS" />

            <!-- Fila 3: 1, 2, 3, Suma -->
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="60.0" text="1" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="4" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="60.0" text="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="4" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="60.0" text="3" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="4" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleOperador" prefHeight="50.0" prefWidth="60.0" styleClass="btn-op" text="+" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS" GridPane.rowIndex="4" GridPane.vgrow="ALWAYS" />

            <!-- Fila 4: 0, Punto decimal e Igual -->
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleDigit" prefHeight="50.0" prefWidth="130.0" text="0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="5" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handlePunto" prefHeight="50.0" prefWidth="60.0" text="." GridPane.columnIndex="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="5" GridPane.vgrow="ALWAYS" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleIgual" prefHeight="50.0" prefWidth="60.0" styleClass="btn-success" text="=" GridPane.columnIndex="3" GridPane.hgrow="ALWAYS" GridPane.rowIndex="5" GridPane.vgrow="ALWAYS" />
         <TextField fx:id="txtPantalla" alignment="CENTER_RIGHT" editable="false" prefHeight="50.0" styleClass="display-field" text="0" GridPane.columnSpan="2147483647" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS" />
        </children>
      <columnConstraints>
         <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
         <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
         <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
         <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints maxHeight="1.7976931348623157E308" minHeight="30.0" prefHeight="30.0" vgrow="ALWAYS" />
         <RowConstraints maxHeight="1.7976931348623157E308" vgrow="ALWAYS" />
         <RowConstraints maxHeight="1.7976931348623157E308" vgrow="ALWAYS" />
         <RowConstraints maxHeight="1.7976931348623157E308" vgrow="ALWAYS" />
         <RowConstraints maxHeight="1.7976931348623157E308" vgrow="ALWAYS" />
         <RowConstraints maxHeight="1.7976931348623157E308" vgrow="ALWAYS" />
      </rowConstraints>
    </GridPane>
